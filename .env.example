# Copy to .env for local development. Never commit real secrets.

# --- Shared ---
APP_ENV=local
APP_VERSION=0.0.0-dev
LOG_LEVEL=info
DEMO_ORG_ID=org_demo

# --- Local infrastructure (docker compose) ---
POSTGRES_USER=matchiq
POSTGRES_PASSWORD=matchiq_local_only
POSTGRES_DB=matchiq
POSTGRES_PORT=54320
REDIS_PORT=63790
DATABASE_URL=postgresql://matchiq:matchiq_local_only@localhost:54320/matchiq
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:63790
# Namespaces Redis channels so environments can share one instance.
REDIS_KEY_PREFIX=matchiq

# --- API (apps/api) ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:4200
RATE_LIMIT_PER_MINUTE=300
# Generate with: openssl rand -hex 32
OPERATOR_API_KEY=
# Transactional outbox relay (runs in the API process; see apps/api/src/app/outbox).
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=200
SSE_HEARTBEAT_MS=15000
# Anonymous replay controls (start session, pause, resume, seek) per client per minute.
REPLAY_RATE_LIMIT_PER_MINUTE=30
# Express trust proxy: false (default), a hop count (1 behind Caddy), or a comma-separated
# list of proxy IPs/CIDRs (or loopback|linklocal|uniquelocal). Without it every client behind
# a reverse proxy shares one rate-limit bucket. `true` is rejected: it trusts spoofed headers.
TRUST_PROXY=false

# --- Worker (apps/worker) ---
WORKER_PORT=3001
AGENTS_SERVICE_URL=http://localhost:8000
# Shared secret between worker and agents. Generate with: openssl rand -hex 32
AGENTS_SERVICE_TOKEN=
# Agents pipeline deadline per insight. Cloud (Foundry) keeps it short; local Ollama needs the
# slow lane (see the local profile below). Max 180000.
AGENT_TIMEOUT_MS=8000
AGENT_MAX_RETRIES=2
AGENT_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_CIRCUIT_COOLDOWN_MS=30000
# Concurrent agents-pipeline jobs and the first retry delay (doubles per attempt).
AGENT_JOB_CONCURRENCY=2
AGENT_RETRY_BACKOFF_MS=500
# false (default): deterministic template narratives and overlays only; the model is never called.
AI_ENABLED=false
# Replay capacity (read by the API and the worker): sessions PLAYING, or created and about to
# start, at once. At the limit the API answers 503 replay-capacity with Retry-After.
REPLAY_MAX_ACTIVE_SESSIONS=10
# Untouched IDLE/PAUSED sessions stop holding a slot and leave worker memory after this.
REPLAY_IDLE_TIMEOUT_MS=600000
# Data retention (docs/operations/DATA_RETENTION.md): sessions untouched for this many days
# are deleted with all their rows; idempotency keys after this many hours. Templates are kept.
RETENTION_ENABLED=true
SESSION_RETENTION_DAYS=7
IDEMPOTENCY_RETENTION_HOURS=24
RETENTION_INTERVAL_MS=3600000
# The worker also runs the outbox relay (DATABASE_URL, REDIS_URL, REDIS_KEY_PREFIX and OUTBOX_* above apply).

# --- Agents (apps/agents) ---
AGENTS_PORT=8000
# mock | ollama | foundry. mock is rejected when APP_ENV=prod.
# ollama = real local inference via Agent Framework's OpenAI-compatible client (no Azure needed).
MODEL_PROVIDER=mock
OLLAMA_ENDPOINT=http://localhost:11434/v1/
OLLAMA_MODEL=qwen2.5:7b-instruct
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=
# Set only in Azure (user-assigned managed identity). Locally, `az login` is used.
AZURE_CLIENT_ID=
# Agents service resilience (AGENT_MAX_RETRIES and AGENT_CIRCUIT_FAILURE_THRESHOLD above are shared).
AGENT_CIRCUIT_RESET_MS=30000
# Optional AI critique pass after the Fact Checker's deterministic checks. Blank = provider
# default: on for foundry/mock, off for ollama. The deterministic Fact Checker always runs.
AGENT_CRITIQUE_ENABLED=
# Consecutive model timeouts that open the agents breaker. Blank = provider default: timeouts
# count as ordinary failures for foundry/mock; 8 in a row for ollama (slow is not down).
AGENT_CIRCUIT_TIMEOUT_THRESHOLD=

# --- Local Ollama profile (real local inference, no Azure) ---
# Templates stay on air instantly; verified agent narratives replace them when they land.
# Measured on an M1 Pro (Ollama 0.40.7): qwen2.5:7b-instruct p50 ~74 s per insight, 4-5 calls.
#   AI_ENABLED=true
#   MODEL_PROVIDER=ollama
#   OLLAMA_MODEL=qwen2.5:7b-instruct
#   AGENT_TIMEOUT_MS=120000
#   AGENT_JOB_CONCURRENCY=1   # Ollama serves one request at a time by default
#   AGENT_CIRCUIT_RESET_MS=60000
# Ollama ignores keep_alive/num_ctx sent over its OpenAI-compatible API; set them on the
# server instead, e.g. `OLLAMA_KEEP_ALIVE=30m ollama serve`.

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_DEMO_MODE=true

# --- Telemetry (optional) ---
OTEL_SERVICE_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING=
