{
  "name": "@matchiq/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "icons:generate": "node scripts/generate-pwa-icons.mjs"
  },
  "nx": {
    "name": "web",
    "sourceRoot": "apps/web/src",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ],
        "command": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{projectRoot}/**/*.spec.tsx"
        ]
      },
      "dev": {
        "options": {
          "port": 4200
        }
      },
      "start": {
        "options": {
          "port": 4200
        }
      }
    }
  },
  "dependencies": {
    "@matchiq/access": "workspace:*",
    "@matchiq/api-client": "workspace:*",
    "@matchiq/config": "workspace:*",
    "@matchiq/contracts": "workspace:*",
    "@tanstack/react-query": "5.103.3",
    "geist": "1.8.1",
    "jose": "6.2.12",
    "next": "16.4.2",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3"
  }
}
