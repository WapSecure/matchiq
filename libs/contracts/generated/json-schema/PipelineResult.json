{
  "title": "PipelineResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PipelineResult",
  "$defs": {
    "PipelineResult": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "DETECTED",
            "ANALYZED",
            "DRAFTED",
            "VERIFIED",
            "SCHEDULED",
            "PUBLISHED",
            "REJECTED",
            "EXPIRED",
            "FALLBACK"
          ]
        },
        "analysis": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "schemaVersion": {
                  "type": "number",
                  "const": 1
                },
                "runId": {
                  "type": "string",
                  "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "agent": {
                  "type": "string",
                  "enum": [
                    "MATCH_ANALYST",
                    "NARRATIVE_WRITER",
                    "FACT_CHECKER",
                    "BROADCAST_PRODUCER",
                    "LOCALIZATION"
                  ]
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "claimType": {
                        "type": "string",
                        "enum": [
                          "OBSERVATION",
                          "INFERENCE"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      },
                      "evidenceEventIds": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                        }
                      },
                      "citedValues": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "metricRef": {
                              "type": "string",
                              "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
                            },
                            "value": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "metricRef",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "claimType",
                      "text",
                      "evidenceEventIds",
                      "citedValues"
                    ],
                    "additionalProperties": false
                  }
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "locale": {
                  "type": "string",
                  "enum": [
                    "en-GB",
                    "fr-FR",
                    "es-ES",
                    "pcm-NG"
                  ]
                },
                "confidenceLabel": {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high"
                  ]
                },
                "traceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "schemaVersion",
                "runId",
                "agent",
                "claims",
                "limitations",
                "locale",
                "confidenceLabel",
                "traceId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "verification": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "REVISE",
                    "REJECT"
                  ]
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "enum": [
                          "UNSUPPORTED_NUMBER",
                          "UNKNOWN_ENTITY",
                          "UNCITED_EVIDENCE",
                          "FORBIDDEN_CLAIM",
                          "SCHEMA_VIOLATION",
                          "LENGTH_EXCEEDED"
                        ]
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "claimIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "code",
                      "detail"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "verdict",
                "issues"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "narratives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NarrativeDraft"
          }
        },
        "overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/OverlayProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "correlationId": {
                "type": "string",
                "format": "uuid"
              },
              "agent": {
                "type": "string",
                "enum": [
                  "MATCH_ANALYST",
                  "NARRATIVE_WRITER",
                  "FACT_CHECKER",
                  "BROADCAST_PRODUCER",
                  "LOCALIZATION"
                ]
              },
              "provider": {
                "type": "string",
                "enum": [
                  "foundry",
                  "ollama",
                  "mock",
                  "template"
                ]
              },
              "modelDeployment": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "promptVersion": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "startedAt": {
                "type": "string",
                "format": "date-time"
              },
              "latencyMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokensIn": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokensOut": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "SUCCEEDED",
                  "FAILED",
                  "TIMED_OUT",
                  "FALLBACK"
                ]
              },
              "promptHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "costEstimateUsd": {
                "type": "number",
                "minimum": 0
              },
              "repairs": {
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "code",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "runId",
              "correlationId",
              "agent",
              "provider",
              "promptVersion",
              "startedAt",
              "latencyMs",
              "retries",
              "outcome"
            ],
            "additionalProperties": false
          }
        },
        "fallbackReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "correlationId",
        "status",
        "analysis",
        "verification",
        "narratives",
        "overlay",
        "runs"
      ],
      "additionalProperties": false
    },
    "NarrativeDraft": {
      "type": "object",
      "properties": {
        "persona": {
          "type": "string",
          "enum": [
            "CASUAL",
            "ANALYST",
            "BROADCAST"
          ]
        },
        "locale": {
          "type": "string",
          "enum": [
            "en-GB",
            "fr-FR",
            "es-ES",
            "pcm-NG"
          ]
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "evidenceEventIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "citedValues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metricRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "metricRef",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "AGENT",
            "TEMPLATE"
          ]
        },
        "localeFallback": {
          "type": "boolean"
        }
      },
      "required": [
        "persona",
        "locale",
        "headline",
        "body",
        "evidenceEventIds",
        "citedValues",
        "source",
        "localeFallback"
      ],
      "additionalProperties": false
    },
    "OverlayProposal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "SCORE_UPDATE",
            "KEY_MOMENT",
            "TACTICAL_INSIGHT",
            "STAT_COMPARISON",
            "DISCIPLINE",
            "SUBSTITUTION"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "durationMs": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 15000
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "body": {
          "type": "string",
          "maxLength": 140
        },
        "evidenceEventIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        },
        "metricRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
          }
        }
      },
      "required": [
        "kind",
        "priority",
        "durationMs",
        "headline",
        "body",
        "evidenceEventIds",
        "metricRefs"
      ],
      "additionalProperties": false
    }
  }
}
