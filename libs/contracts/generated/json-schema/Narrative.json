{
  "title": "Narrative",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "narrativeId": {
      "type": "string",
      "pattern": "^nr_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^fx_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "insightId": {
      "type": "string",
      "pattern": "^in_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "persona": {
      "type": "string",
      "enum": [
        "CASUAL",
        "ANALYST",
        "BROADCAST"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "en-GB",
        "fr-FR",
        "es-ES",
        "pcm-NG"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "citations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "AGENT",
        "TEMPLATE"
      ]
    },
    "localeFallback": {
      "type": "boolean"
    },
    "breakdown": {
      "$ref": "#/$defs/AnalystBreakdown"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "narrativeId",
    "fixtureId",
    "insightId",
    "persona",
    "locale",
    "headline",
    "body",
    "citations",
    "source",
    "localeFallback",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "AnalystBreakdown": {
      "type": "object",
      "properties": {
        "whatHappened": {
          "$ref": "#/$defs/BreakdownPart"
        },
        "whyItMatters": {
          "$ref": "#/$defs/BreakdownPart"
        },
        "whatToWatch": {
          "$ref": "#/$defs/BreakdownPart"
        }
      },
      "required": [
        "whatHappened",
        "whyItMatters",
        "whatToWatch"
      ],
      "additionalProperties": false
    },
    "BreakdownPart": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "citedValues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metricRef": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "metricRef",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "evidenceEventIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          }
        }
      },
      "required": [
        "text",
        "citedValues",
        "evidenceEventIds"
      ],
      "additionalProperties": false
    }
  }
}
