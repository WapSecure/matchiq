{
  "title": "Fixture",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "fixtureId": {
      "type": "string",
      "pattern": "^fx_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "competitionLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "kickoffUtc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "SCHEDULED",
        "LIVE",
        "COMPLETED",
        "ABANDONED"
      ]
    },
    "home": {
      "$ref": "#/$defs/Team"
    },
    "away": {
      "$ref": "#/$defs/Team"
    },
    "pitch": {
      "type": "object",
      "properties": {
        "lengthM": {
          "type": "number",
          "minimum": 90,
          "maximum": 120
        },
        "widthM": {
          "type": "number",
          "minimum": 45,
          "maximum": 90
        }
      },
      "required": [
        "lengthM",
        "widthM"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "schemaVersion",
    "fixtureId",
    "title",
    "competitionLabel",
    "kickoffUtc",
    "status",
    "home",
    "away",
    "pitch",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "Team": {
      "type": "object",
      "properties": {
        "teamId": {
          "type": "string",
          "pattern": "^tm_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "shortName": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "secondary": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "primary",
            "secondary"
          ],
          "additionalProperties": false
        },
        "formation": {
          "type": "string",
          "pattern": "^\\d(-\\d){2,4}$"
        },
        "players": {
          "minItems": 11,
          "maxItems": 26,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Player"
          }
        },
        "synthetic": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "teamId",
        "name",
        "shortName",
        "colors",
        "formation",
        "players",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "Player": {
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "pattern": "^pl_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "teamId": {
          "type": "string",
          "pattern": "^tm_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "shirtNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "position": {
          "type": "string",
          "enum": [
            "GK",
            "DF",
            "MF",
            "FW"
          ]
        },
        "starting": {
          "type": "boolean"
        },
        "synthetic": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "playerId",
        "teamId",
        "displayName",
        "shirtNumber",
        "position",
        "starting",
        "synthetic"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "oneOf": [
        {
          "$ref": "#/$defs/SyntheticProvenance"
        }
      ]
    },
    "SyntheticProvenance": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "synthetic"
        },
        "generatorVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scenario": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "kind",
        "generatorVersion",
        "seed",
        "scenario"
      ],
      "additionalProperties": false
    }
  }
}
