{
  "title": "AgentRun",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "agent": {
      "type": "string",
      "enum": [
        "MATCH_ANALYST",
        "NARRATIVE_WRITER",
        "FACT_CHECKER",
        "BROADCAST_PRODUCER",
        "LOCALIZATION"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "foundry",
        "ollama",
        "mock",
        "template"
      ]
    },
    "modelDeployment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "promptVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensIn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensOut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "FALLBACK"
      ]
    },
    "promptHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "costEstimateUsd": {
      "type": "number",
      "minimum": 0
    },
    "repairs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "faultInjected": {
      "$ref": "#/$defs/FaultScenario"
    },
    "faultNote": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "runId",
    "correlationId",
    "agent",
    "provider",
    "promptVersion",
    "startedAt",
    "latencyMs",
    "retries",
    "outcome"
  ],
  "additionalProperties": false,
  "$defs": {
    "FaultScenario": {
      "type": "string",
      "enum": [
        "WRITER_REVISE",
        "MODEL_TIMEOUT",
        "GATE_REJECT"
      ]
    }
  }
}
