{
  "title": "AgentRun",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "agent": {
      "type": "string",
      "enum": [
        "MATCH_ANALYST",
        "NARRATIVE_WRITER",
        "FACT_CHECKER",
        "BROADCAST_PRODUCER",
        "LOCALIZATION"
      ]
    },
    "provider": {
      "type": "string",
      "enum": [
        "foundry",
        "mock",
        "template"
      ]
    },
    "modelDeployment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "promptVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensIn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokensOut": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "FALLBACK"
      ]
    }
  },
  "required": [
    "runId",
    "correlationId",
    "agent",
    "provider",
    "promptVersion",
    "startedAt",
    "latencyMs",
    "retries",
    "outcome"
  ],
  "additionalProperties": false
}
