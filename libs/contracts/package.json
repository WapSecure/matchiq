{
  "name": "@matchiq/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "contracts",
    "tags": [
      "scope:shared",
      "type:contract"
    ],
    "targets": {
      "export-json-schema": {
        "dependsOn": [
          "build"
        ],
        "command": "node scripts/export-json-schema.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/generated/json-schema"
        ],
        "cache": true
      }
    }
  },
  "dependencies": {
    "tslib": "2.8.1",
    "zod": "4.6.7"
  }
}
