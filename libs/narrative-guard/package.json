{
  "name": "@matchiq/narrative-guard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "narrative-guard",
    "tags": [
      "scope:shared",
      "type:domain"
    ],
    "targets": {
      "export-lexicon": {
        "dependsOn": [
          "build"
        ],
        "command": "node scripts/export-lexicon.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/generated"
        ],
        "cache": true
      }
    }
  },
  "dependencies": {
    "@matchiq/contracts": "workspace:*",
    "tslib": "2.8.1"
  }
}
