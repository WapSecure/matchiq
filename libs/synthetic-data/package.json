{
  "name": "@matchiq/synthetic-data",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "synthetic-data",
    "tags": [
      "scope:shared",
      "type:domain"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          {
            "fileset": "{projectRoot}/tsconfig.spec.json",
            "dependencies": true
          },
          {
            "json": "{workspaceRoot}/tsconfig.json",
            "fields": [
              "compilerOptions"
            ]
          },
          {
            "externalDependencies": [
              "vitest",
              "fast-check"
            ]
          },
          {
            "env": "CI"
          },
          {
            "dependentTasksOutputFiles": "**/*.js",
            "transitive": true
          },
          "{workspaceRoot}/fixtures/**/*"
        ]
      }
    }
  },
  "dependencies": {
    "@matchiq/contracts": "workspace:*",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  }
}
