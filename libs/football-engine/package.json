{
  "name": "@matchiq/football-engine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./geometry": {
      "@matchiq/source": "./src/geometry.ts",
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js",
      "default": "./dist/geometry.js"
    },
    "./player": {
      "@matchiq/source": "./src/player.ts",
      "types": "./dist/player.d.ts",
      "import": "./dist/player.js",
      "default": "./dist/player.js"
    }
  },
  "nx": {
    "name": "football-engine",
    "tags": [
      "scope:shared",
      "type:domain"
    ]
  },
  "dependencies": {
    "@matchiq/canonical-json": "workspace:*",
    "@matchiq/contracts": "workspace:*",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
