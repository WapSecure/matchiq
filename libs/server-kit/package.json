{
  "name": "@matchiq/server-kit",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tracing": {
      "@matchiq/source": "./src/tracing.ts",
      "types": "./dist/tracing.d.ts",
      "import": "./dist/tracing.js",
      "default": "./dist/tracing.js"
    }
  },
  "nx": {
    "name": "server-kit",
    "tags": [
      "scope:server",
      "type:util"
    ]
  },
  "dependencies": {
    "@matchiq/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.69.0",
    "@opentelemetry/instrumentation-pg": "0.75.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "bullmq": "5.81.5",
    "bullmq-otel": "1.3.1",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "reflect-metadata": "0.2.2",
    "supertest": "7.3.1"
  }
}
