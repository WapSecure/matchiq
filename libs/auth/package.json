{
  "name": "@matchiq/auth",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@matchiq/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "nx": {
    "name": "auth",
    "tags": [
      "scope:server",
      "type:data-access"
    ]
  },
  "dependencies": {
    "@matchiq/access": "workspace:*",
    "@matchiq/config": "workspace:*",
    "@matchiq/server-kit": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "jose": "6.2.12",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1"
  }
}
