{
  "name": "@matchiq/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@matchiq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@matchiq/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "nx": {
    "name": "db",
    "tags": [
      "scope:server",
      "type:data-access"
    ],
    "targets": {
      "migrate": {
        "dependsOn": [
          "build"
        ],
        "command": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": false
      },
      "generate-migration": {
        "command": "drizzle-kit generate --config drizzle.config.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": false
      }
    }
  },
  "dependencies": {
    "@matchiq/config": "workspace:*",
    "@matchiq/contracts": "workspace:*",
    "drizzle-orm": "0.45.3",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
