{
  "realm": "matchiq",
  "displayName": "MatchIQ (local development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientScopeMappings": {
    "matchiq-api": [
      {
        "client": "matchiq-web",
        "roles": [
          "platform-operator",
          "tenant-owner",
          "producer",
          "analyst",
          "developer",
          "viewer"
        ]
      }
    ]
  },
  "roles": {
    "client": {
      "matchiq-api": [
        {
          "name": "platform-operator",
          "description": "MatchIQ platform-operator (spec \u00a740)",
          "clientRole": true
        },
        {
          "name": "tenant-owner",
          "description": "MatchIQ tenant-owner (spec \u00a740)",
          "clientRole": true
        },
        {
          "name": "producer",
          "description": "MatchIQ producer (spec \u00a740)",
          "clientRole": true
        },
        {
          "name": "analyst",
          "description": "MatchIQ analyst (spec \u00a740)",
          "clientRole": true
        },
        {
          "name": "developer",
          "description": "MatchIQ developer (spec \u00a740)",
          "clientRole": true
        },
        {
          "name": "viewer",
          "description": "MatchIQ viewer (spec \u00a740)",
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "matchiq-api",
      "name": "MatchIQ API (resource server)",
      "description": "Audience of access tokens; holds the product roles.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "matchiq-web",
      "name": "MatchIQ web (BFF)",
      "description": "Authorization Code + PKCE. Public client for local development only.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:4200/auth/callback",
        "http://localhost:4318/auth/callback",
        "http://localhost:4328/auth/callback",
        "http://127.0.0.1:4318/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:4318",
        "http://localhost:4328",
        "http://127.0.0.1:4318"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:4318/*##http://localhost:4328/*##http://127.0.0.1:4318/*",
        "access.token.lifespan": "300"
      },
      "fullScopeAllowed": false,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "audience-matchiq-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "matchiq-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org",
            "claim.name": "org",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "org-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_name",
            "claim.name": "org_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "matchiq-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "matchiq-api",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
