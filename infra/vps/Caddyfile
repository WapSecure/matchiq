# Single-host demo: one origin, automatic HTTPS. MATCHIQ_DOMAIN must resolve to this host.
{$MATCHIQ_DOMAIN} {
	encode zstd gzip

	# Edge baseline; the apps set CSP and the remaining headers per response.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	handle /api/* {
		# Flush immediately so SSE frames are not buffered.
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:4200
	}
}
