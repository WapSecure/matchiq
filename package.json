{
  "name": "@matchiq/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many -t serve dev -p api worker agents web",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "e2e": "nx run web-e2e:e2e",
    "codegen": "nx run agents:codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:fixture": "nx run synthetic-data:build --output-style=static 1>&2 && node libs/synthetic-data/dist/cli/generate-fixture.js",
    "validate:fixture": "nx run synthetic-data:build --output-style=static 1>&2 && node libs/synthetic-data/dist/cli/validate-fixture.js",
    "verify": "nx sync:check && pnpm format:check && nx run-many -t lint typecheck test build",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@next/eslint-plugin-next": "16.4.2",
    "@nx/devkit": "23.2.0",
    "@nx/eslint": "23.2.0",
    "@nx/eslint-plugin": "23.2.0",
    "@nx/jest": "23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "23.2.0",
    "@nx/next": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/playwright": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@playwright/test": "1.64.1",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "1.8.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.0.0",
    "fast-check": "4.10.2",
    "jest": "30.3.0",
    "jest-environment-node": "30.3.0",
    "jest-util": "30.3.0",
    "jiti": "2.4.2",
    "jsdom": "27.4.0",
    "jsonc-eslint-parser": "2.4.2",
    "nx": "23.2.0",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
